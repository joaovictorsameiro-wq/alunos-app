# Banco de dados PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Senha de acesso ao app
APP_PASSWORD=sua_senha_aqui

# JWT Secret (gere uma string aleatória longa)
JWT_SECRET=uma_string_muito_secreta_aqui_123456

# Hotmart API
HOTMART_CLIENT_ID=seu_client_id
HOTMART_CLIENT_SECRET=seu_client_secret
HOTMART_SUBDOMAIN=prime-expert
